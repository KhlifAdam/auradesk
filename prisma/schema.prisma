// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       Boolean   @map("email_verified")
  image               String?
  /// Preferred language (`en` | `fr`); picks the language of emails sent to them.
  locale              String?
  /// E.164. Set for accounts created from a phone number (client sign-in by SMS code).
  phoneNumber         String?   @unique @map("phone_number")
  phoneNumberVerified Boolean?  @map("phone_number_verified")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  sessions            Session[]
  accounts            Account[]

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  studio           Studio?
  /// The photographer's AuraDesk plan (free month, then paid).
  subscription     Subscription?
  /// Conversations with the AI assistant; personal to this user.
  assistantThreads AssistantThread[]
  /// Photo books this person designed from their delivered photos.
  photoBooks       PhotoBook[]       @relation("ClientBooks")
  /// Photo book orders sent to this photographer, and the prices they set for them.
  bookOrders       PhotoBook[]       @relation("PhotographerBooks")
  bookPriceList    BookPriceList?
  media            Media[]
  albums           Album[]
  packages         Package[]

  projects            Project[]          @relation("PhotographerProjects")
  clientProjects      Project[]          @relation("ClientProjects")
  clientProfiles      ClientProfile[]    @relation("ProfilesOwned")
  profilesAboutMe     ClientProfile[]    @relation("ProfilesAbout")
  galleries           Gallery[]
  galleryItems        GalleryItem[]
  galleryComments     GalleryComment[]
  driveImports        DriveImport[]
  uploadSessions      UploadSession[]
  calendarEvents      CalendarEvent[]
  studioConversations Conversation[]     @relation("ConversationPhotographer")
  clientConversations Conversation[]     @relation("ConversationClient")
  sentMessages        Message[]
  bookings            Booking[]          @relation("PhotographerBookings")
  clientBookings      Booking[]          @relation("ClientBookings")
  invoices            Invoice[]          @relation("PhotographerInvoices")
  clientInvoices      Invoice[]          @relation("ClientInvoices")
  equipment           Equipment[]
  equipmentBookings   EquipmentBooking[]
  teamMembers         TeamMember[]       @relation("StudioTeam")
  teamMemberships     TeamMember[]       @relation("TeamMemberships")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  impersonatedBy String? @map("impersonated_by")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  accountId  String @map("account_id")
  providerId String @map("provider_id")

  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  idToken String? @map("id_token")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── Public site ─────────────────────────────────────────────────────────────
// Every model below is tenant-scoped by `photographerId` (the owning User).

enum SiteTemplate {
  MINIMAL
  EDITORIAL
  BOLD

  @@map("site_template")
}

enum FontPair {
  MODERN
  CLASSIC
  ELEGANT

  @@map("font_pair")
}

enum ThemeMode {
  LIGHT
  DARK
  BOTH

  @@map("theme_mode")
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

model Studio {
  id                     String       @id @default(cuid())
  photographerId         String       @unique @map("photographer_id")
  slug                   String       @unique
  name                   String
  tagline                String?
  bio                    String?
  email                  String?
  phone                  String?
  city                   String?
  country                String?
  /// { instagram?, facebook?, youtube?, vimeo?, tiktok?, website? }
  socials                Json         @default("{}")
  logoMediaId            String?      @map("logo_media_id")
  coverMediaId           String?      @map("cover_media_id")
  template               SiteTemplate @default(MINIMAL)
  accentColor            String       @default("#c8a96e") @map("accent_color")
  fontPair               FontPair     @default(MODERN) @map("font_pair")
  /// LIGHT / DARK forces one palette; BOTH follows the visitor (with a toggle).
  themeMode              ThemeMode    @default(BOTH) @map("theme_mode")
  /// Languages the public site is offered in (subset of the app locales).
  locales                String[]     @default(["en"])
  defaultLocale          String       @default("en") @map("default_locale")
  published              Boolean      @default(false)
  bookingEnabled         Boolean      @default(true) @map("booking_enabled")
  /// Galleries are deleted this many months after delivery; null keeps them.
  galleryRetentionMonths Int?         @map("gallery_retention_months")
  /// Removes GPS position from JPEG originals while they upload.
  stripGalleryLocation   Boolean      @default(false) @map("strip_gallery_location")
  /// Projects move forward through the workflow on their own as work happens
  /// (photos imported, gallery shared, selection sent…). See projects/auto-stage.
  autoAdvanceStages      Boolean      @default(true) @map("auto_advance_stages")
  /// Order, visibility and content of the public site's sections (clients,
  /// testimonials, stats, showreel, FAQ…). Validated by services/site-sections.
  sections               Json         @default("[]")
  /// Unsaved sections being edited, shown only in the dashboard's live
  /// preview. Cleared when the sections are saved.
  sectionsDraft          Json?        @map("sections_draft")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  photographer User   @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  logo         Media? @relation("StudioLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  cover        Media? @relation("StudioCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@map("studios")
}

model Media {
  id             String    @id @default(cuid())
  photographerId String    @map("photographer_id")
  type           MediaType
  /// Object key in the R2 bucket: `{photographerId}/{cuid}.{ext}`
  key            String    @unique
  filename       String
  mimeType       String    @map("mime_type")
  size           Int
  width          Int?
  height         Int?
  durationSec    Float?    @map("duration_sec")
  alt            String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  photographer  User        @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  albumItems    AlbumItem[]
  studioLogos   Studio[]    @relation("StudioLogo")
  studioCovers  Studio[]    @relation("StudioCover")
  albumCovers   Album[]     @relation("AlbumCover")
  packageCovers Package[]   @relation("PackageCover")

  @@index([photographerId, createdAt])
  @@map("media")
}

model Album {
  id             String   @id @default(cuid())
  photographerId String   @map("photographer_id")
  title          String
  slug           String
  description    String?
  coverMediaId   String?  @map("cover_media_id")
  position       Int      @default(0)
  published      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  photographer User        @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  cover        Media?      @relation("AlbumCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  items        AlbumItem[]

  @@unique([photographerId, slug])
  @@index([photographerId, position])
  @@map("albums")
}

model AlbumItem {
  albumId  String @map("album_id")
  mediaId  String @map("media_id")
  position Int    @default(0)

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([albumId, mediaId])
  @@index([albumId, position])
  @@map("album_items")
}

model Package {
  id              String   @id @default(cuid())
  photographerId  String   @map("photographer_id")
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("TND")
  durationMinutes Int?     @map("duration_minutes")
  deliverables    String[] @default([])
  coverMediaId    String?  @map("cover_media_id")
  position        Int      @default(0)
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  photographer User   @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  cover        Media? @relation("PackageCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  @@index([photographerId, position])
  @@map("packages")
}

// ─── Clients, projects & private galleries ───────────────────────────────────
// Dashboard queries scope by `photographerId`; portal queries by `clientId`.
// A client is attached to a project by accepting an invitation.

enum ProjectStage {
  BOOKING
  PREP
  SHOOTING
  IMPORT
  ORGANIZATION
  SELECTION
  POST_PRODUCTION
  EXPORT
  VALIDATION
  DELIVERY

  @@map("project_stage")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED

  @@map("invite_status")
}

/// A photographer's private record about a client. Never grants access:
/// that comes only from accepted projects.
model ClientProfile {
  id             String   @id @default(cuid())
  photographerId String   @map("photographer_id")
  clientId       String   @map("client_id")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  photographer User @relation("ProfilesOwned", fields: [photographerId], references: [id], onDelete: Cascade)
  client       User @relation("ProfilesAbout", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([photographerId, clientId])
  @@index([clientId])
  @@map("client_profiles")
}

enum ProjectServiceType {
  WEDDING
  ENGAGEMENT
  BIRTHDAY
  EVENT
  PRODUCT
  PORTRAIT
  ADVERTISING
  CORPORATE
  OTHER

  @@map("project_service_type")
}

enum ProjectMediaType {
  PHOTO
  VIDEO
  BOTH

  @@map("project_media_type")
}

enum ProjectLocationType {
  STUDIO
  OUTDOOR
  HOME
  COMPANY
  OTHER

  @@map("project_location_type")
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID

  @@map("payment_status")
}

model Project {
  id             String             @id @default(cuid())
  photographerId String             @map("photographer_id")
  /// Set when the invited client accepts.
  clientId       String?            @map("client_id")
  /// Lowercased address the invitation was sent to.
  inviteEmail    String?            @map("invite_email")
  /// E.164 number the invitation was texted to, for clients without an email.
  invitePhone    String?            @map("invite_phone")
  inviteStatus   InviteStatus?      @map("invite_status")
  invitedAt      DateTime?          @map("invited_at")
  title          String
  description    String?
  eventDate      DateTime?          @map("event_date")
  location       String?
  stage          ProjectStage       @default(BOOKING)
  /// When the project reached DELIVERY (cleared if it moves back); feeds the statistics.
  deliveredAt    DateTime?          @map("delivered_at")
  serviceType    ProjectServiceType @default(OTHER) @map("service_type")
  mediaType      ProjectMediaType   @default(PHOTO) @map("media_type")

  // Client details kept on the project (the account has no phone number).
  clientPhone  String? @map("client_phone")
  contactName  String? @map("contact_name")
  contactPhone String? @map("contact_phone")
  clientNotes  String? @map("client_notes")

  // Planning. `eventDate` is the day; times are local `HH:mm`.
  startTime        String?              @map("start_time")
  endTime          String?              @map("end_time")
  locationType     ProjectLocationType? @map("location_type")
  deliveryDeadline DateTime?            @map("delivery_deadline")
  equipment        String?

  // Money, in TND. A project that isn't PAID can't reach DELIVERY or show
  // files to its client.
  price          Decimal?      @db.Decimal(12, 3)
  advance        Decimal       @default(0) @db.Decimal(12, 3)
  paymentStatus  PaymentStatus @default(UNPAID) @map("payment_status")
  financialNotes String?       @map("financial_notes")

  // Organisation.
  team          String?
  internalNotes String?  @map("internal_notes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  photographer      User                @relation("PhotographerProjects", fields: [photographerId], references: [id], onDelete: Cascade)
  client            User?               @relation("ClientProjects", fields: [clientId], references: [id], onDelete: SetNull)
  galleries         Gallery[]
  photoBooks        PhotoBook[]
  events            CalendarEvent[]
  booking           Booking?
  invoices          Invoice[]
  equipmentBookings EquipmentBooking[]
  assignments       ProjectAssignment[]

  @@index([photographerId, stage, updatedAt])
  @@index([photographerId, createdAt])
  @@index([clientId, updatedAt])
  @@index([inviteEmail, inviteStatus])
  @@index([invitePhone, inviteStatus])
  @@map("projects")
}

/// PROOFS: light copies for choosing (the originals stay on the photographer's
/// disk). FINAL: the edited photos, delivered in full quality.
enum GalleryKind {
  PROOFS
  FINAL

  @@map("gallery_kind")
}

/// Layout of the cover page at the top of a gallery (client view and link).
enum CoverTemplate {
  CLASSIC
  SPLIT
  FRAME
  NONE

  @@map("cover_template")
}

model Gallery {
  id               String        @id @default(cuid())
  photographerId   String        @map("photographer_id")
  projectId        String        @map("project_id")
  title            String
  description      String?
  kind             GalleryKind   @default(FINAL)
  position         Int           @default(0)
  selectionEnabled Boolean       @default(true) @map("selection_enabled")
  selectionLimit   Int?          @map("selection_limit")
  /// Previews shown to the client before delivery carry the studio's mark.
  watermark        Boolean       @default(true)
  /// The photographer lets the client open a view-only link to the gallery.
  linkSharing      Boolean       @default(true) @map("link_sharing")
  coverTemplate    CoverTemplate @default(CLASSIC) @map("cover_template")
  /// Photo shown on the cover; null (or deleted) falls back to the first one.
  coverItemId      String?       @map("cover_item_id")
  /// Point of the photo kept in frame when the cover crops it (0 to 1).
  coverFocalX      Float         @default(0.5) @map("cover_focal_x")
  coverFocalY      Float         @default(0.5) @map("cover_focal_y")
  /// Secret of the client's "anyone with the link" URL; null when not shared.
  shareToken       String?       @unique @map("share_token")
  /// Link visitors may download the originals (once delivered and paid).
  shareDownloads   Boolean       @default(false) @map("share_downloads")
  shareExpiresAt   DateTime?     @map("share_expires_at")
  sharedAt         DateTime?     @map("shared_at")
  submittedAt      DateTime?     @map("submitted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  photographer   User            @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items          GalleryItem[]
  driveImports   DriveImport[]
  uploadSessions UploadSession[]

  @@index([projectId, position])
  @@index([photographerId])
  @@map("galleries")
}

model GalleryItem {
  id                 String    @id @default(cuid())
  galleryId          String    @map("gallery_id")
  photographerId     String    @map("photographer_id")
  /// Object key in the private R2 bucket.
  key                String    @unique
  previewKey         String?   @map("preview_key")
  filename           String
  mimeType           String    @map("mime_type")
  /// Bytes; BigInt because videos can pass 2 GB.
  size               BigInt
  type               MediaType @default(IMAGE)
  /// Seconds, for videos.
  durationSec        Float?    @map("duration_sec")
  width              Int?
  height             Int?
  position           Int       @default(0)
  selected           Boolean   @default(false)
  /// Google Drive file this was imported from; stops the same file entering a gallery twice.
  driveFileId        String?   @map("drive_file_id")
  /// When the photo or video was taken (EXIF / container metadata), for chronological order.
  capturedAt         DateTime? @map("captured_at")
  /// The device it came from, e.g. "SONY ILCE-7M4": the media's source.
  camera             String?
  /// Set once the file's metadata was read (even if it had none).
  metadataReadAt     DateTime? @map("metadata_read_at")
  /// The name it was uploaded with, kept when the gallery is renamed (to restore it).
  originalFilename   String?   @map("original_filename")
  /// Proofs only: size and date of the original left on the photographer's
  /// disk, so it can be found again among the shoot's files.
  originalSize       BigInt?   @map("original_size")
  originalModifiedAt DateTime? @map("original_modified_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  gallery       Gallery          @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  photographer  User             @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  comments      GalleryComment[]
  analysis      PhotoAnalysis?
  videoAnalysis VideoAnalysis?

  @@unique([galleryId, driveFileId])
  @@index([galleryId, position])
  @@index([galleryId, selected])
  @@map("gallery_items")
}

model GalleryComment {
  id            String   @id @default(cuid())
  galleryItemId String   @map("gallery_item_id")
  authorId      String   @map("author_id")
  body          String
  createdAt     DateTime @default(now()) @map("created_at")

  item   GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([galleryItemId, createdAt])
  @@map("gallery_comments")
}

// ─── Google Drive import ─────────────────────────────────────────────────────
// A photographer picks files in Google Drive; a background worker copies them
// into a private gallery. One row per file, so progress and retries are per file.

enum DriveImportStatus {
  PENDING
  RUNNING
  DONE
  FAILED

  @@map("drive_import_status")
}

model DriveImport {
  id             String            @id @default(cuid())
  photographerId String            @map("photographer_id")
  galleryId      String            @map("gallery_id")
  status         DriveImportStatus @default(PENDING)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  photographer User              @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  gallery      Gallery           @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  items        DriveImportItem[]

  @@index([photographerId, createdAt])
  @@index([galleryId])
  @@map("drive_imports")
}

model DriveImportItem {
  id          String            @id @default(cuid())
  importId    String            @map("import_id")
  driveFileId String            @map("drive_file_id")
  filename    String
  mimeType    String            @map("mime_type")
  /// Bytes; BigInt because videos (a later step) can pass 2 GB.
  size        BigInt
  status      DriveImportStatus @default(PENDING)
  /// Message key or short reason when `status` is FAILED.
  error       String?
  attempts    Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  import DriveImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, driveFileId])
  @@index([importId, status])
  @@map("drive_import_items")
}

// ─── Calendar ────────────────────────────────────────────────────────────────
// The photographer's schedule: shoots, meetings, and the days they are
// available or not. All-day events store UTC midnights of their first and last
// day (inclusive); timed events store real instants.

enum CalendarEventType {
  SHOOT
  MEETING
  AVAILABLE
  UNAVAILABLE
  OTHER

  @@map("calendar_event_type")
}

model CalendarEvent {
  id             String            @id @default(cuid())
  photographerId String            @map("photographer_id")
  /// Optional link to the project this event is for.
  projectId      String?           @map("project_id")
  type           CalendarEventType @default(SHOOT)
  title          String
  allDay         Boolean           @default(false) @map("all_day")
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  location       String?
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  photographer User     @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([photographerId, startsAt])
  @@index([photographerId, endsAt])
  @@index([projectId])
  @@map("calendar_events")
}

// ─── Messaging ───────────────────────────────────────────────────────────────
// One conversation per photographer–client pair. A pair may only talk while it
// shares an accepted project; counters are kept on the row so lists and the
// unread badge never scan messages.

model Conversation {
  id                 String    @id @default(cuid())
  photographerId     String    @map("photographer_id")
  clientId           String    @map("client_id")
  lastMessageAt      DateTime? @map("last_message_at")
  /// First characters of the latest message, for the conversation list.
  lastMessagePreview String?   @map("last_message_preview")
  lastSenderId       String?   @map("last_sender_id")
  photographerUnread Int       @default(0) @map("photographer_unread")
  clientUnread       Int       @default(0) @map("client_unread")
  createdAt          DateTime  @default(now()) @map("created_at")

  photographer User      @relation("ConversationPhotographer", fields: [photographerId], references: [id], onDelete: Cascade)
  client       User      @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([photographerId, clientId])
  @@index([photographerId, lastMessageAt])
  @@index([clientId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@map("messages")
}

// ─── Bookings ────────────────────────────────────────────────────────────────
// The commercial phase: a request, its negotiation and the quote. Only a
// CONFIRMED booking becomes a Project (kept linked through `projectId`).
// The client is stored as contact details so prospects without an account fit;
// `clientId` links to the account once it exists.

enum BookingStatus {
  NEW
  DISCUSSION
  QUOTE_SENT
  CONFIRMED
  /// Declined or cancelled; `statusReason` says why.
  DECLINED

  @@map("booking_status")
}

enum BookingSource {
  INSTAGRAM
  WHATSAPP
  PHONE
  WEBSITE
  OTHER
  /// Asked by the client from their own space.
  PORTAL

  @@map("booking_source")
}

enum BookingActivityKind {
  CREATED
  STATUS
  NOTE
  /// The photographer sent the request to the client.
  SENT
  /// The client changed some of the details; `body` lists the fields.
  CLIENT_EDIT
  CLIENT_ACCEPT
  CLIENT_DECLINE

  @@map("booking_activity_kind")
}

model Booking {
  id               String             @id @default(cuid())
  photographerId   String             @map("photographer_id")
  clientId         String?            @map("client_id")
  projectId        String?            @unique @map("project_id")
  title            String
  status           BookingStatus      @default(NEW)
  source           BookingSource      @default(OTHER)
  clientName       String             @map("client_name")
  clientEmail      String?            @map("client_email")
  clientPhone      String?            @map("client_phone")
  serviceType      ProjectServiceType @default(OTHER) @map("service_type")
  mediaType        ProjectMediaType   @default(PHOTO) @map("media_type")
  description      String?
  desiredDate      DateTime?          @map("desired_date")
  startTime        String?            @map("start_time")
  durationMinutes  Int?               @map("duration_minutes")
  location         String?
  /// Indicative budget of the client, in TND.
  clientBudget     Decimal?           @map("client_budget") @db.Decimal(12, 3)
  /// Price offered by the photographer, in TND; becomes the project price.
  proposedPrice    Decimal?           @map("proposed_price") @db.Decimal(12, 3)
  plannedAdvance   Decimal?           @map("planned_advance") @db.Decimal(12, 3)
  responseDeadline DateTime?          @map("response_deadline")
  internalNotes    String?            @map("internal_notes")
  statusReason     String?            @map("status_reason")
  confirmedAt      DateTime?          @map("confirmed_at")
  /// Set when the photographer sends the request to the client; the client
  /// can then read it in their portal and fill in their part.
  sentToClientAt   DateTime?          @map("sent_to_client_at")
  /// The client accepted the proposal; the photographer confirms next.
  clientAcceptedAt DateTime?          @map("client_accepted_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  photographer User              @relation("PhotographerBookings", fields: [photographerId], references: [id], onDelete: Cascade)
  client       User?             @relation("ClientBookings", fields: [clientId], references: [id], onDelete: SetNull)
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  activities   BookingActivity[]

  @@index([photographerId, status, desiredDate])
  @@index([photographerId, createdAt])
  @@index([clientId])
  @@map("bookings")
}

model BookingActivity {
  id         String              @id @default(cuid())
  bookingId  String              @map("booking_id")
  kind       BookingActivityKind
  fromStatus BookingStatus?      @map("from_status")
  toStatus   BookingStatus?      @map("to_status")
  body       String?
  createdAt  DateTime            @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_activities")
}

// ─── Project file import ─────────────────────────────────────────────────────
// A large file goes to the private bucket in parts (S3 multipart upload). The
// session remembers the upload, so choosing the same file again resumes it
// instead of starting over. It is deleted once the file is in the gallery.

model UploadSession {
  id             String   @id @default(cuid())
  photographerId String   @map("photographer_id")
  galleryId      String   @map("gallery_id")
  /// Object key the parts are assembled into.
  key            String   @unique
  /// The bucket's multipart upload id.
  uploadId       String   @map("upload_id")
  filename       String
  mimeType       String   @map("mime_type")
  size           BigInt
  partSize       Int      @map("part_size")
  /// Name, size and last-modified time of the file, to recognise it when chosen again.
  fingerprint    String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  photographer User    @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  gallery      Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@unique([galleryId, fingerprint])
  @@index([photographerId, galleryId])
  @@map("upload_sessions")
}

// ─── Invoicing ───────────────────────────────────────────────────────────────
// An invoice copies the client's details so it stays as issued even if the
// client or the project changes later. Totals are computed from the lines.
// Payments on a project's invoices keep the project's advance and payment
// status in sync.

enum InvoiceStatus {
  DRAFT
  /// Issued to the client; overdue is derived from `dueDate`.
  SENT
  PAID
  CANCELLED

  @@map("invoice_status")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER

  @@map("payment_method")
}

model Invoice {
  id             String        @id @default(cuid())
  photographerId String        @map("photographer_id")
  projectId      String?       @map("project_id")
  /// The client's account, when they have one; lets them read it in the portal.
  clientId       String?       @map("client_id")
  /// INV-2026-0001, unique per photographer.
  number         String
  status         InvoiceStatus @default(DRAFT)
  clientName     String        @map("client_name")
  clientEmail    String?       @map("client_email")
  clientPhone    String?       @map("client_phone")
  clientAddress  String?       @map("client_address")
  issueDate      DateTime      @map("issue_date")
  dueDate        DateTime?     @map("due_date")
  /// Percentage, e.g. 19 for 19 % VAT.
  taxRate        Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  /// Amount taken off the subtotal, in TND, before tax.
  discount       Decimal       @default(0) @db.Decimal(12, 3)
  notes          String?
  sentAt         DateTime?     @map("sent_at")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  photographer User             @relation("PhotographerInvoices", fields: [photographerId], references: [id], onDelete: Cascade)
  client       User?            @relation("ClientInvoices", fields: [clientId], references: [id], onDelete: SetNull)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     InvoicePayment[]
  /// The photo book order this invoice bills, if any.
  photoBook    PhotoBook?

  @@unique([photographerId, number])
  @@index([photographerId, status, issueDate])
  @@index([photographerId, createdAt])
  @@index([projectId])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 3)
  position    Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
  @@map("invoice_items")
}

model InvoicePayment {
  id        String        @id @default(cuid())
  invoiceId String        @map("invoice_id")
  amount    Decimal       @db.Decimal(12, 3)
  paidAt    DateTime      @map("paid_at")
  method    PaymentMethod @default(CASH)
  reference String?
  createdAt DateTime      @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, paidAt])
  @@map("invoice_payments")
}

// ─── Equipment & rentals ─────────────────────────────────────────────────────
// The photographer's gear and when each item is busy: on a project's shoot,
// rented out to someone, hired from a supplier, or away for repair. Two
// bookings of one item never overlap.

enum EquipmentCategory {
  CAMERA
  LENS
  LIGHTING
  AUDIO
  DRONE
  SUPPORT
  STORAGE
  COMPUTER
  OTHER

  @@map("equipment_category")
}

enum EquipmentStatus {
  ACTIVE
  /// Out of order: can't be booked until it's active again.
  BROKEN
  RETIRED

  @@map("equipment_status")
}

enum EquipmentOwnership {
  OWNED
  /// Hired from a supplier for a while; `rentalBookings` say when.
  HIRED

  @@map("equipment_ownership")
}

enum EquipmentBookingKind {
  /// Used on one of the photographer's projects.
  PROJECT
  /// Lent to someone else for a fee.
  RENTAL_OUT
  /// Hired in from a supplier.
  RENTAL_IN
  MAINTENANCE

  @@map("equipment_booking_kind")
}

model Equipment {
  id             String             @id @default(cuid())
  photographerId String             @map("photographer_id")
  name           String
  category       EquipmentCategory  @default(OTHER)
  brand          String?
  model          String?
  serialNumber   String?            @map("serial_number")
  status         EquipmentStatus    @default(ACTIVE)
  ownership      EquipmentOwnership @default(OWNED)
  purchaseDate   DateTime?          @map("purchase_date")
  /// Purchase price, in TND.
  purchasePrice  Decimal?           @map("purchase_price") @db.Decimal(12, 3)
  /// Price per day when rented out, in TND.
  dailyRate      Decimal?           @map("daily_rate") @db.Decimal(12, 3)
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  photographer User               @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  bookings     EquipmentBooking[]

  @@index([photographerId, category, name])
  @@index([photographerId, createdAt])
  @@map("equipment")
}

model EquipmentBooking {
  id             String               @id @default(cuid())
  photographerId String               @map("photographer_id")
  equipmentId    String               @map("equipment_id")
  projectId      String?              @map("project_id")
  kind           EquipmentBookingKind @default(PROJECT)
  /// First and last day (inclusive), stored at UTC midnight.
  startDate      DateTime             @map("start_date")
  endDate        DateTime             @map("end_date")
  /// Who rents it, or the supplier it's hired from.
  partyName      String?              @map("party_name")
  /// Fee received (rented out) or paid (hired in / repair), in TND.
  amount         Decimal?             @db.Decimal(12, 3)
  notes          String?
  /// Set when the item came back.
  returnedAt     DateTime?            @map("returned_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  photographer User      @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([equipmentId, startDate, endDate])
  @@index([photographerId, startDate])
  @@index([projectId])
  @@map("equipment_bookings")
}

// ─── Team ────────────────────────────────────────────────────────────────────
// Collaborators (editor, second shooter, drone pilot…) invited by email. Once
// they accept with a verified address, they see only the projects they are
// assigned to, without prices, client notes or internal notes.

model TeamMember {
  id             String       @id @default(cuid())
  photographerId String       @map("photographer_id")
  /// Set when the invitation is accepted.
  userId         String?      @map("user_id")
  name           String
  /// Lowercased address the invitation was sent to.
  email          String
  /// What they do: editor, drone pilot, assistant…
  specialty      String?
  status         InviteStatus @default(PENDING)
  invitedAt      DateTime     @default(now()) @map("invited_at")
  respondedAt    DateTime?    @map("responded_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  photographer User                @relation("StudioTeam", fields: [photographerId], references: [id], onDelete: Cascade)
  user         User?               @relation("TeamMemberships", fields: [userId], references: [id], onDelete: SetNull)
  assignments  ProjectAssignment[]

  @@unique([photographerId, email])
  @@index([photographerId, name])
  @@index([email, status])
  @@index([userId, status])
  @@map("team_members")
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  memberId  String   @map("member_id")
  /// Their job on this project, e.g. "Second shooter".
  role      String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([memberId])
  @@map("project_assignments")
}

// ─── AI photo assistant ──────────────────────────────────────────────────────
// What the assistant found on one photo, computed on the server from its
// preview. Near-duplicates are grouped at read time by comparing hashes.

model PhotoAnalysis {
  id                String   @id @default(cuid())
  itemId            String   @unique @map("item_id")
  galleryId         String   @map("gallery_id")
  /// Variance of the Laplacian: low means blurry.
  sharpness         Float
  /// Mean luminance, 0 (black) to 1 (white).
  brightness        Float
  /// Share of pixels blown to white / crushed to black.
  highlightsClipped Float    @map("highlights_clipped")
  shadowsClipped    Float    @map("shadows_clipped")
  /// 64-bit difference hash, as 16 hex characters.
  hash              String
  /// BLURRY, UNDEREXPOSED, OVEREXPOSED, EYES_CLOSED.
  flags             String[] @default([])
  /// Null when no vision model was available to check faces.
  eyesClosed        Boolean? @map("eyes_closed")
  analyzedAt        DateTime @default(now()) @map("analyzed_at")

  item GalleryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@map("photo_analyses")
}

// ─── AI video assistant ──────────────────────────────────────────────────────
// What the assistant found in one video: where the shots change, where the
// sound drops out, and (with a vision model) what kind of clip it is.

model VideoAnalysis {
  id           String   @id @default(cuid())
  itemId       String   @unique @map("item_id")
  galleryId    String   @map("gallery_id")
  durationSec  Float    @map("duration_sec")
  /// Seconds at which a new shot starts (the first shot starts at 0).
  sceneCuts    Float[]  @default([]) @map("scene_cuts")
  /// [{ start, end }] in seconds.
  silences     Json     @default("[]")
  hasAudio     Boolean  @map("has_audio")
  /// Share of the video without sound, 0 to 1.
  silenceRatio Float    @map("silence_ratio")
  /// CEREMONY, SPEECH, DANCE…; null without a vision model.
  category     String?
  /// One-line description of the clip, from the vision model.
  summary      String?
  analyzedAt   DateTime @default(now()) @map("analyzed_at")

  item GalleryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@map("video_analyses")
}

/// What an administrator did to an account.
enum AdminAction {
  BAN
  UNBAN
  GRANT_ADMIN
  REVOKE_ADMIN
  PAYMENT_RECORDED

  @@map("admin_action")
}

// ─── AuraDesk billing ─────────────────────────────────────────────────────────
// Every photographer starts with a free month. Payment is made outside the
// app (transfer, cash…); an admin records it, which extends `paidUntil`.

enum SubscriptionPlan {
  STARTER
  PRO
  STUDIO

  @@map("subscription_plan")
}

enum BillingCycle {
  MONTHLY
  YEARLY

  @@map("billing_cycle")
}

model Subscription {
  id             String           @id @default(cuid())
  photographerId String           @unique @map("photographer_id")
  /// The plan the photographer chose; billed once the free month is over.
  plan           SubscriptionPlan @default(PRO)
  cycle          BillingCycle     @default(MONTHLY)
  trialEndsAt    DateTime         @map("trial_ends_at")
  /// End of the period already paid; null until the first payment.
  paidUntil      DateTime?        @map("paid_until")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  photographer User @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Who did what to whom, and why. Names are copied in, so the log still reads
/// after an account is deleted.
model AdminAuditLog {
  id          String      @id @default(cuid())
  /// Null when done from the server's command line (`pnpm admin:grant`).
  actorId     String?     @map("actor_id")
  actorName   String      @map("actor_name")
  action      AdminAction
  targetId    String?     @map("target_id")
  targetName  String      @map("target_name")
  targetEmail String?     @map("target_email")
  reason      String?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_audit_logs")
}

/// One conversation with the AI assistant. Threads are personal: only the user
/// who started one can read it, whatever their role.
model AssistantThread {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  /// The first words of the opening question; the user can rename it.
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId, updatedAt])
  @@map("assistant_threads")
}

/// A message in AI SDK UI format: text, tool calls and their results as JSON
/// parts. Ids come from the chat client, so they are only unique per thread.
model AssistantMessage {
  id        String
  threadId  String   @map("thread_id")
  role      String
  parts     Json
  /// Order within the thread.
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([threadId, id])
  @@index([threadId, position])
  @@map("assistant_messages")
}

/// A photo book a client designs from the final photos of a delivered project.
/// `design` holds the whole layout (cover, pages, which photo goes where) as
/// JSON, checked on every save against the shape in `lib/books/design.ts`;
/// the print-ready PDF is built from it on demand.
model PhotoBook {
  id             String          @id @default(cuid())
  projectId      String          @map("project_id")
  clientId       String          @map("client_id")
  /// The studio that prints it (the project's photographer); lets every studio query stay scoped.
  photographerId String          @map("photographer_id")
  /// Same as `design.title`, kept here for lists.
  title          String
  design         Json
  /// DRAFT while the client designs it; once sent, the design is locked.
  status         BookOrderStatus @default(DRAFT)
  copies         Int             @default(1)
  /// What the client chose: cover, paper and extras, as ids of the studio's price list.
  options        Json?
  /// The client's message to the studio with the order.
  clientNote     String          @default("") @map("client_note")
  /// The price as calculated when it was sent: lines, per copy and total, so later price changes don't move it.
  quote          Json?
  /// What the studio finally charges (the quote, unless they adjusted it).
  total          Decimal?        @db.Decimal(12, 3)
  /// The studio's note when it sends a book back to the client.
  statusNote     String          @default("") @map("status_note")
  invoiceId      String?         @unique @map("invoice_id")
  submittedAt    DateTime?       @map("submitted_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client       User     @relation("ClientBooks", fields: [clientId], references: [id], onDelete: Cascade)
  photographer User     @relation("PhotographerBooks", fields: [photographerId], references: [id], onDelete: Cascade)
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([clientId, projectId])
  @@index([photographerId, status, submittedAt])
  @@map("photo_books")
}

/// Where a photo book order stands. The studio moves it along; production only
/// starts once the invoice is paid.
enum BookOrderStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  IN_PRODUCTION
  READY
  DELIVERED

  @@map("book_order_status")
}

/// What a studio charges for photo books: a price per size, extra pages, and
/// the covers, papers and extras it offers. Checked by `lib/books/pricing.ts`.
model BookPriceList {
  photographerId String   @id @map("photographer_id")
  data           Json
  updatedAt      DateTime @updatedAt @map("updated_at")

  photographer User @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@map("book_price_lists")
}
