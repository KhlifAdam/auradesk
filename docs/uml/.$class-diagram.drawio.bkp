parent="e_Role"><mxGeometry y="40" width="190" height="70" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;• photographer / client: a User whose role is PHOTOGRAPHER / CLIENT.&lt;br&gt;• The role can change: a client may open a studio and become a photographer.&lt;br&gt;• Each booking, quote, invoice, project, equipment, event and team member belongs to one photographer.&lt;br&gt;• A booking becomes a project only once it is confirmed.&lt;br&gt;• A project is delivered only once it is paid.&lt;br&gt;• A team member only sees the projects assigned to them." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#fffde7;strokeColor=#b0a060;" vertex="1" parent="1"><mxGeometry x="40" y="977" width="520" height="110" as="geometry"/></mxCell><mxCell id="lg" value="&lt;b&gt;Modules&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1840" y="454" width="190" height="170" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1850" y="483" width="18" height="12" as="geometry"/></mxCell><mxCell id="lgt0" value="Users &amp; access" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1874" y="480" width="150" height="18" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1850" y="503" width="18" height="12" as="geometry"/></mxCell><mxCell id="lgt1" value="Public site" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1874" y="500" width="150" height="18" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=0;html=1;fillColor=#fff2cc;