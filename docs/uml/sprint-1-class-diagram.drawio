align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="e_TypeFournisseur"><mxGeometry y="40" width="220" height="55" as="geometry"/></mxCell><mxCell id="e_CanalEnvoi" value="&lt;span style=&quot;font-weight:normal;font-size:10px&quot;&gt;«enumeration»&lt;/span&gt;&lt;br&gt;CanalEnvoi" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="763" width="220" height="95" as="geometry"/></mxCell><mxCell id="e_CanalEnvoi_v" value="EMAIL&lt;br&gt;SMS&lt;br&gt;WHATSAPP" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="e_CanalEnvoi"><mxGeometry y="40" width="220" height="55" as="geometry"/></mxCell><mxCell id="e_TypeVerification" value="&lt;span style=&quot;font-weight:normal;font-size:10px&quot;&gt;«enumeration»&lt;/span&gt;&lt;br&gt;TypeVerification" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="643" width="220" height="110" as="geometry"/></mxCell><mxCell id="e_TypeVerification_v" value="VERIFICATION_EMAIL&lt;br&gt;REINITIALISATION_MDP&lt;br&gt;CHANGEMENT_EMAIL&lt;br&gt;CONNEXION_TELEPHONE" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="e_TypeVerification"><mxGeometry y="40" width="220" height="70" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Diagramme de classes du sprint 1&lt;/b&gt; &lt;span style=&quot;font-size:12px&quot;&gt;— Authentification et gestion des utilisateurs&lt;/span&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Règles&lt;/b&gt;&lt;br&gt;• Le rôle peut évoluer (un client ouvre un studio, un administrateur accorde ce rôle) : il est donc un attribut de type Role.&lt;br&gt;• Seul un utilisateur dont le rôle est ADMINISTRATEUR accède à GestionComptes.&lt;br&gt;• Un code de vérification compte 6 chiffres, expire après 10 minutes et autorise 3 tentatives.&lt;br&gt;• Un même numéro reçoit au plus 1 code par minute et 10 codes par jour.&lt;br&gt;• Les mots de passe et les codes sont stockés sous forme d'empreinte (hachés).&lt;br&gt;• La suspension d'un compte révoque toutes ses sessions ; un administrateur ne peut pas être suspendu." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#fffde7;strokeColor=#b0a060;" vertex="1" parent="1"><mxGeometry x="40" y="851" width="690" height="112" as="geometry"/></mxCell><mxCell id="e1" value="ouvre" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.0000;exitY=0.2179;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.4433;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c_Utilisateur" target="c_Session"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1_m0" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e1"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-14" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e1_m1" value="0..*" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e1"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="14" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="se connecte via" style="endArrow=none;startArrow=diamondThin;startFill=1;startSize=16;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2179;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5202;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c_Utilisateur" target="c_Compte"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2_m0" value="1" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e2"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="14" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e2_m1" value="0..*" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e2"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-14" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="«vérifie»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c_Verification" target="c_Utilisateur"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="85"/><mxPoint x="565" y="85"/></Array></mxGeometry></mxCell><mxCell id="e4" value="«gère»" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;fontStyle=2;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c_GestionComptes" target="c_Utilisateur"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>