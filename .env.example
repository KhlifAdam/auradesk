# Database (docker-compose.yml)
DATABASE_URL="postgresql://postgres:password@localhost:5432/lumodesk"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP (password reset emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Cloudflare R2 (media storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PRIVATE_BUCKET=""
# Public CDN base URL for media (custom domain or r2.dev).
# DB stores only object keys, so changing this updates every media URL.
R2_PUBLIC_URL=""

# Text messages (client sign-in codes, invitations). `console` prints them in
# the server log; `twilio` sends real SMS.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# AI vision checks (closed eyes, clip labels). Unset skips them.
OPENROUTER_API_KEY=
