# Database (docker-compose.yml)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP (password reset emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Cloudflare R2 (media storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PRIVATE_BUCKET=""
# Public CDN base URL for media (custom domain or r2.dev).
# DB stores only object keys, so changing this updates every media URL.
R2_PUBLIC_URL=""

# Text messages (client sign-in codes, invitations). `console` prints them in
# the server log; `twilio` sends real SMS; `whatsapp` sends them from the number
# linked in /admin/whatsapp (needs the wa-gateway service, `pnpm wa:dev`).
SMS_PROVIDER=console
# With `whatsapp`: what sends a message WhatsApp can't deliver (`console` or `twilio`).
SMS_FALLBACK_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# The WhatsApp gateway (wa-gateway/). The secret is shared with it (min 32 characters).
WA_GATEWAY_URL=http://localhost:4000
WA_GATEWAY_SECRET=

# AI (OpenRouter): vision checks, the chat assistant and voice notes. Unset turns them off.
OPENROUTER_API_KEY=
# Optional: the assistant's chat model (an OpenRouter id that supports tools).
ASSISTANT_MODEL=
# Optional: live word-by-word dictation (Soniox). Unset falls back to OpenRouter.
SONIOX_API_KEY=
# The platform's main administrator. Create or reset it with `pnpm admin:create`.
ADMIN_EMAIL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=auradesk
POSTGRES_PORT=5432

# Host port the app listens on (loopback only; nginx proxies to it).
APP_PORT=50002
